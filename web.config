<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <system.webServer>
    <iisnode nodeProcessCommandLine="C:\Program Files\nodejs\node.exe" loggingEnabled="false" />

    <handlers>
      <add name="iisnode" path="server.js" verb="*" modules="iisnode" />
    </handlers>

    <rewrite>
      <rules>
        <!-- No interferir con las peticiones de depuración de iisnode -->
        <rule name="NodeInspector" patternSyntax="ECMAScript" stopProcessing="true">
          <match url="^server.js/_inspector" />
        </rule>

        <!-- Mapear el tráfico hacia el archivo server.js -->
        <rule name="DynamicContent">
          <conditions>
            <add input="{REQUEST_FILENAME}" matchType="IsFile" negate="True" />
          </conditions>
          <action type="Rewrite" url="server.js" />
        </rule>
      </rules>
    </rewrite>

    <!-- Excluir la carpeta node_modules y archivos de configuración del acceso público -->
    <security>
      <requestFiltering>
        <hiddenSegments>
          <remove segment="bin" />
          <add segment="node_modules" />
          <add segment="iisnode" />
          <add segment="datos" />
          <add segment="respaldos" />
        </hiddenSegments>
      </requestFiltering>
    </security>

    <!-- Control de errores detallados en el servidor -->
    <httpErrors existingResponse="PassThrough" />
    
  </system.webServer>
</configuration>