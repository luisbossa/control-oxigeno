# Copie este archivo como .env solo si necesita cambiar algo. Ninguna variable es obligatoria.

# Puerto del servidor local (npm start).
PORT=3000

# Secreto para firmar las sesiones. Si no se define, se genera uno y se guarda en la base.
# En Vercel conviene definirlo en Settings > Environment Variables.
SESION_SECRETO=

# Horas que dura la sesión sin actividad (12 si no se define). Mientras el sistema
# esté abierto, la sesión se renueva sola.
SESION_HORAS=

# Base Turso (SQLite alojado). Si se definen, se usan en lugar del archivo datos/oxigeno.db.
# Recomendado en Vercel: sin Turso, la base vive en /tmp y se borra al reiniciarse la función.
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=
